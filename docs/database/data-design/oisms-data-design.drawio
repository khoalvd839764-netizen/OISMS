        <mxCell id="n-59" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;price_lists&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_lists_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_lists_2 (tenant_id, code)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_lists_code: code IN (&#39;retail&#39;, &#39;wholesale&#39;)&lt;br&gt;&lt;br&gt;&lt;b&gt;price_change_requests&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_change_requests_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_change_requests_2 (tenant_id, request_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_requests_kind: kind IN (&#39;Opening&#39;, &#39;Initial&#39;, &#39;Change&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_requests_status: status IN (&#39;Pending&#39;, &#39;Approved&#39;, &#39;Rejected&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_requests_created_by: kind = &#39;Opening&#39; OR created_by IS NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_requests_pending_reviewed: (status = &#39;Pending&#39;) = (reviewed_at IS NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_requests_reason: btrim(reason) &amp;lt;&amp;gt; &#39;&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; price_change_request_guard: BEFORE UPDATE → oisms_price_change_request_guard()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; price_change_request_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;price_change_request_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SI&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_change_request_items_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_price_change_request_items_2 (tenant_id, request_id, price_list_id, sku_id, unit_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_price_change_request_items_new_price: new_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; price_change_item_append_only: BEFORE UPDATE OR DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;sku_unit_prices&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_unit_prices_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_unit_prices_2 (tenant_id, source_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_unit_prices_active_key (tenant_id, price_list_id, sku_id, unit_id, valid_from) WHERE cancelled_at IS NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_unit_prices_price: price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_unit_prices_cancel_state: (cancelled_at IS NULL AND cancelled_by IS NULL AND cancel_reason IS NULL) OR (cancelled...&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; sku_unit_price_guard: BEFORE UPDATE → oisms_sku_unit_price_guard()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; sku_unit_price_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;" vertex="1">
