geometry"/></mxCell><mxCell id="e-100" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-79" target="r-14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-101" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-81" target="r-15" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-102" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-83" target="r-16" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-103" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-17" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-105" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1739" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-106" value="&lt;b&gt;inventory_balances&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_balances_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_balances_2 (tenant_id, branch_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_inventory_balances_sku_branches (tenant_id, sku_id, branch_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_on_hand_nonnegative: on_hand &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_reserved_nonnegative: reserved &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_average_cost_nonnegative: average_cost &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_reorder_point_nonnegative: reorder_point &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_last_sequence_nonnegative: last_sequence &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_balances_reservation_limit: reserved &amp;lt;= on_hand&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_lock: BEFORE INSERT OR UPDATE → oisms_lock_stock()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_consistency: CONSTRAINT AFTER INSERT OR UPDATE, DEFERRED → oisms_stock_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;warehouse_inventory_balances&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_warehouse_inventory_balances_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_warehouse_inventory_balances_2 (tenant_id, warehouse_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_warehouse_inventory_balances_branch_sku (tenant_id, branch_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_warehouse_inventory_balances_on_hand_nonnegative: on_hand &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_warehouse_inventory_balances_reserved_nonnegative: reserved &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_warehouse_inventory_balances_last_sequence_nonnegative: last_sequence &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_warehouse_inventory_balances_reservation_limit: reserved &amp;lt;= on_hand&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_lock: BEFORE INSERT OR UPDATE → oisms_lock_stock()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_consistency: CONSTRAINT AFTER INSERT OR UPDATE, DEFERRED → oisms_stock_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;inventory_transactions&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_2 (tenant_id, branch_id, sku_id, sequence_no)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_3 (tenant_id, receipt_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_4 (tenant_id, order_item_id, warehouse_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_5 (tenant_id, transfer_item_id, type)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_6 (tenant_id, stock_count_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_7 (tenant_id, sales_return_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_transactions_8 (tenant_id, adjustment_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_inventory_transactions_sku_history (tenant_id, branch_id, sku_id, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_inventory_transactions_tenant_history (tenant_id, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_inventory_transactions_sku (tenant_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_inventory_transactions_warehouse_sku (tenant_id, warehouse_id, sku_id, sequence_no)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_type_values: type IN ('IN', 'OUT')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_quantity_positive: quantity &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_sequence_no_positive: sequence_no &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_unit_cost_nonnegative: unit_cost &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_balance_after_nonnegative: balance_after &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_one_source: num_nonnulls(receipt_item_id, order_item_id, transfer_item_id, stock_count_item_id, sal...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_transactions_source_direction: (receipt_item_id IS NULL OR type = 'IN') AND (order_item_id IS NULL OR type = 'OUT') AN...&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_lock: BEFORE INSERT OR UPDATE → oisms_lock_stock()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_consistency: CONSTRAINT AFTER INSERT OR UPDATE, DEFERRED → oisms_stock_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; ledger_append_only: BEFORE UPDATE OR DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;inventory_adjustments&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_adjustments_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_adjustments_2 (tenant_id, number)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_adjustments_3 (tenant_id, id, branch_id, warehouse_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustments_status_values: status IN ('Draft', 'Confirmed', 'Cancelled')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustments_reason_required: length(btrim(reason)) &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustments_confirmed: (status = 'Confirmed') = (confirmed_at IS NOT NULL) AND (confirmed_at IS NULL) = (confi...&lt;br&gt;&lt;br&gt;&lt;b&gt;inventory_adjustment_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_adjustment_items_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_inventory_adjustment_items_2 (tenant_id, adjustment_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustment_items_nonzero_delta: quantity_delta &amp;lt;&amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustment_items_unit_cost_nonnegative: unit_cost &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_inventory_adjustment_items_incoming_cost: quantity_delta &amp;lt; 0 OR unit_cost IS NOT NULL&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="1739" y="310" width="981" height="999" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dd-06" name="DD-06 Chuyển kho"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-46" value="&lt;b&gt;06. Chuyển kho&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(Data Design · 2 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="stock_transfers" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="298" height="388" as="geometry"/></mxCell><mxCell id="r-2" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uuid&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;o