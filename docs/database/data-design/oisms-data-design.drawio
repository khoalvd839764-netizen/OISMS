        <mxCell id="n-94" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;categories&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_categories_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_categories_not_self_parent: parent_id IS NULL OR parent_id &amp;lt;&amp;gt; id&lt;br&gt;&lt;br&gt;&lt;b&gt;brands&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_brands_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;products&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_products_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;skus&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_2 (tenant_id, code)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_3 (tenant_id, barcode)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_skus_product (tenant_id, product_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_attributes_object: jsonb_typeof(attributes) = &#39;object&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_code_normalized: code = upper(btrim(code)) AND length(code) &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_barcode_pair: (barcode_type IS NULL) = (barcode IS NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_barcode_type_values: barcode_type IN (&#39;EAN13&#39;, &#39;Code128&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_ean_shape: barcode_type &amp;lt;&amp;gt; &#39;EAN13&#39; OR barcode ~ &#39;^[0-9]{13}$&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_retail_price_nonnegative: retail_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_wholesale_price_nonnegative: wholesale_price &amp;gt;= 0&lt;br&gt;&lt;br&gt;&lt;b&gt;units&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_units_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_units_2 (tenant_id, code)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_measure_group: measure_group IN (&#39;Mass&#39;, &#39;Volume&#39;, &#39;Length&#39;, &#39;Count&#39;, &#39;Packaging&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_decimal_places: decimal_places &amp;gt;= 0 AND decimal_places &amp;lt;= 3&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_code_normalized: code = lower(btrim(code)) AND length(code) &amp;gt; 0&lt;br&gt;&lt;br&gt;&lt;b&gt;sku_units&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_units_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_units_2 (tenant_id, sku_id, unit_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_default_sale (tenant_id, sku_id) WHERE is_default_sale AND is_active&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_default_purchase (tenant_id, sku_id) WHERE is_default_purchase AND is_active&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_barcode (tenant_id, barcode) WHERE barcode IS NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_factor_positive: factor_to_base &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_sale_price_nonnegative: sale_price IS NULL OR sale_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_decimal_places: quantity_decimal_places &amp;gt;= 0 AND quantity_decimal_places &amp;lt;= 3&lt;br&gt;&lt;br&gt;&lt;b&gt;sku_unit_factor_history&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SI&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_unit_factor_history_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_unit_factor_history_new_factor: new_factor &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; factor_history_append_only: BEFORE UPDATE OR DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;" vertex="1">
          <mxGeometry height="699" width="727" x="1383" y="451" as="geometry" />
        </mxCell>
      </root>
