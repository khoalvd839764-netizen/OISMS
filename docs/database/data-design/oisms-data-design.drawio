smallint" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-69" vertex="1"><mxGeometry x="0" y="148" width="270" height="20" as="geometry"/></mxCell><mxCell id="r-77" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-69" vertex="1"><mxGeometry x="0" y="168" width="270" height="20" as="geometry"/></mxCell><mxCell id="r-78" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;timestamptz" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-69" vertex="1"><mxGeometry x="0" y="188" width="270" height="20" as="geometry"/></mxCell><mxCell id="r-79" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated_at&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;timestamptz&amp;nbsp;?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-69" vertex="1"><mxGeometry x="0" y="208" width="270" height="20" as="geometry"/></mxCell><mxCell id="t-80" value="users  (→ trang 01)" style="swimlane;fontStyle=2;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#888888;dashed=1;" parent="1" vertex="1"><mxGeometry x="1360" y="120" width="166" height="48" as="geometry"/></mxCell><mxCell id="r-81" value="&lt;font color=&quot;#888888&quot;&gt;&lt;u&gt;PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id&lt;/u&gt;&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-80" vertex="1"><mxGeometry x="0" y="28" width="166" height="20" as="geometry"/></mxCell><mxCell id="e-82" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-83" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-62" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-84" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-53" target="r-63" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-85" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-60" target="r-30" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-86" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-70" target="r-38" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-87" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-28" target="r-12" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-88" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-70" target="r-13" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-89" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-81" target="r-24" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-90" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-10" target="r-45" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-91" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-81" target="r-50" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-93" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1606" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-94" value="&lt;b&gt;categories&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_categories_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_categories_not_self_parent: parent_id IS NULL OR parent_id &amp;lt;&amp;gt; id&lt;br&gt;&lt;br&gt;&lt;b&gt;brands&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_brands_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;products&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_products_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;skus&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_2 (tenant_id, code)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_skus_3 (tenant_id, barcode)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_skus_product (tenant_id, product_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_attributes_object: jsonb_typeof(attributes) = 'object'&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_code_normalized: code = upper(btrim(code)) AND length(code) &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_barcode_pair: (barcode_type IS NULL) = (barcode IS NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_barcode_type_values: barcode_type IN ('EAN13', 'Code128')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_ean_shape: barcode_type &amp;lt;&amp;gt; 'EAN13' OR barcode ~ '^[0-9]{13}$'&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_retail_price_nonnegative: retail_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_skus_wholesale_price_nonnegative: wholesale_price &amp;gt;= 0&lt;br&gt;&lt;br&gt;&lt;b&gt;units&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_units_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_units_2 (tenant_id, code)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_measure_group: measure_group IN ('Mass', 'Volume', 'Length', 'Count', 'Packaging')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_decimal_places: decimal_places &amp;gt;= 0 AND decimal_places &amp;lt;= 3&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_units_code_normalized: code = lower(btrim(code)) AND length(code) &amp;gt; 0&lt;br&gt;&lt;br&gt;&lt;b&gt;sku_units&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_units_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_units_2 (tenant_id, sku_id, unit_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_default_sale (tenant_id, sku_id) WHERE is_default_sale AND is_active&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_default_purchase (tenant_id, sku_id) WHERE is_default_purchase AND is_active&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX ux_sku_units_barcode (tenant_id, barcode) WHERE barcode IS NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_factor_positive: factor_to_base &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_sale_price_nonnegative: sale_price IS NULL OR sale_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_units_decimal_places: quantity_decimal_places &amp;gt;= 0 AND quantity_decimal_places &amp;lt;= 3&lt;br&gt;&lt;br&gt;&lt;b&gt;sku_unit_factor_history&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SI&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_sku_unit_factor_history_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_sku_unit_factor_history_new_factor: new_factor &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; factor_history_append_only: BEFORE UPDATE OR DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="1606" y="310" width="727" height="699" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dd-03" name="DD-03 Bảng giá"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-57" value="&lt;b&gt;03. Bảng giá&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(Data Design · 4 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="price_change_requests" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="318" height="268" as="geometry"/></mxCell><mxCell id="r-2" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uuid&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-1" vertex="1"><mxGeometry x="0" y="28" width="318" height="20" as="geometry"/></mxCell><mxCell id="r-3" value="FK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tenant_id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uuid" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-1" vertex="1"><mxGeometry x="0" y="48" width="318" height="20" as="geometry"/></mxCell><mxCell id="r-4" value="UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;