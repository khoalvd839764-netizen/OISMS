;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-37" target="r-74" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-119" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-73" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-120" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-57" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-121" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-24" target="r-67" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-122" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-104" target="r-35" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-123" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-110" target="r-43" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-124" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-112" target="r-50" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-125" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-87" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-126" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-102" target="r-88" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-127" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-104" target="r-94" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-128" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-104" target="r-17" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-130" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1817" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-131" value="&lt;b&gt;orders&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_orders_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_orders_2 (tenant_id, number)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_orders_3 (tenant_id, request_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_orders_4 (tenant_id, channel, external_shop_id, external_order_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_orders_5 (tenant_id, id, branch_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_orders_branch_history (tenant_id, branch_id, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_orders_status_history (tenant_id, status, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_orders_tenant_created_at (tenant_id, created_at)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_channel_values: channel IN ('POS', 'Admin', 'Shopee', 'TikTok', 'Lazada')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_status_values: status IN ('Draft', 'Reserved', 'Confirmed', 'Completed', 'Cancelled')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_total_amount_nonnegative: total_amount &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_external_identity: (channel IN ('Shopee','TikTok','Lazada') AND external_shop_id IS NOT NULL AND external_...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_confirmation_time: status NOT IN ('Confirmed','Completed') OR confirmed_at IS NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_completion_time: (status &amp;lt;&amp;gt; 'Completed' OR completed_at IS NOT NULL) AND (completed_at IS NULL OR confir...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_orders_cancellation_time: (status = 'Cancelled') = (cancelled_at IS NOT NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; order_cost_snapshot: AFTER INSERT OR UPDATE → oisms_order_cost_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; protect_order: BEFORE UPDATE → oisms_protect_order()&lt;br&gt;&lt;br&gt;&lt;b&gt;order_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_order_items_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_order_items_2 (tenant_id, order_id, sku_id, unit_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_order_items_3 (tenant_id, id, order_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_order_items_sku_orders (tenant_id, sku_id, order_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_factor_snapshot_positive: factor_snapshot &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_quantity_positive: quantity &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_unit_price_nonnegative: unit_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_cost_price_nonnegative: cost_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_price_source: price_source IN ('PriceList', 'Marketplace', 'Legacy')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_order_items_price_source_ref: (price_source = 'PriceList') = (sku_unit_price_id IS NOT NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; item_cost_snapshot: AFTER INSERT OR UPDATE → oisms_order_cost_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; protect_order_item: BEFORE UPDATE OR DELETE → oisms_protect_order_item()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; no_truncate_order_items: BEFORE TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;reservations&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_reservations_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_reservations_2 (tenant_id, order_item_id, warehouse_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_reservations_expiry (status, expires_at, tenant_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_reservations_branch_sku_status (tenant_id, branch_id, sku_id, status)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_reservations_quantity_positive: quantity &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_reservations_status_values: status IN ('Active', 'Consumed', 'Released', 'Expired')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_reservations_expiry: expires_at &amp;gt; created_at&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_lock: BEFORE INSERT OR UPDATE → oisms_lock_stock()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_consistency: CONSTRAINT AFTER INSERT OR UPDATE, DEFERRED → oisms_stock_constraint()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;payment_accounts