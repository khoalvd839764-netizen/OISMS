alAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-38" vertex="1"><mxGeometry x="0" y="28" width="159" height="20" as="geometry"/></mxCell><mxCell id="e-40" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-37" target="r-5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-41" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-39" target="r-7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-42" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-37" target="r-18" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-43" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-39" target="r-19" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-44" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-37" target="r-31" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-46" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1184" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-47" value="&lt;b&gt;daily_sales_summaries&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_daily_sales_summaries_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_daily_sales_summaries_2 (tenant_id, business_date, branch_id, channel, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_daily_sales_summaries_channel_values: channel IN ('POS', 'Admin', 'Shopee', 'TikTok', 'Lazada')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_daily_sales_summaries_sold_quantity_nonnegative: sold_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_daily_sales_summaries_returned_quantity_nonnegative: returned_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_daily_sales_summaries_revenue_nonnegative: revenue &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_daily_sales_summaries_return_amount_nonnegative: return_amount &amp;gt;= 0&lt;br&gt;&lt;br&gt;&lt;b&gt;replenishment_suggestions&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_replenishment_suggestions_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_replenishment_suggestions_2 (tenant_id, branch_id, sku_id, forecast_date, horizon_days)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_replenishment_suggestions_horizon_days_positive: horizon_days &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_replenishment_suggestions_predicted_quantity_nonnegative: predicted_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_replenishment_suggestions_suggested_quantity_nonnegative: suggested_quantity &amp;gt;= 0&lt;br&gt;&lt;br&gt;&lt;b&gt;shop_integrations&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_shop_integrations_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_shop_integrations_2 (tenant_id, channel, external_shop_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_shop_integrations_secret_hash (secret_hash)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_shop_integrations_channel: channel IN ('Shopee', 'TikTok', 'Lazada')&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="1184" y="310" width="740" height="354" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
