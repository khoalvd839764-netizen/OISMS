amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;text&amp;nbsp;?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-39" vertex="1"><mxGeometry x="0" y="88" width="243" height="20" as="geometry"/></mxCell><mxCell id="r-44" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active&amp;nbsp;&amp;nbsp;&amp;nbsp;boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-39" vertex="1"><mxGeometry x="0" y="108" width="243" height="20" as="geometry"/></mxCell><mxCell id="r-45" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at&amp;nbsp;&amp;nbsp;timestamptz" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-39" vertex="1"><mxGeometry x="0" y="128" width="243" height="20" as="geometry"/></mxCell><mxCell id="r-46" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated_at&amp;nbsp;&amp;nbsp;timestamptz&amp;nbsp;?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-39" vertex="1"><mxGeometry x="0" y="148" width="243" height="20" as="geometry"/></mxCell><mxCell id="e-47" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-13" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-48" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-49" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-40" target="r-15" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-50" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-51" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-19" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-52" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-20" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-53" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-41" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-54" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-27" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-55" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-40" target="r-28" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-57" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1217" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-58" value="&lt;b&gt;tenants&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_users_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_users_2 (email)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_users_3 (phone)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_users_role_values: role IN ('Owner', 'Staff', 'Cashier')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_users_login_identity: email IS NOT NULL OR phone IS NOT NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_users_email_normalized: email IS NULL OR (email = lower(btrim(email)) AND length(email) &amp;gt; 0)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_users_phone_normalized: phone IS NULL OR phone ~ '^\+[1-9][0-9]{7,14}$'&lt;br&gt;&lt;br&gt;&lt;b&gt;refresh_tokens&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_refresh_tokens_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_refresh_tokens_2 (token_hash)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_refresh_tokens_user (tenant_id, user_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_refresh_tokens_expiry: expires_at &amp;gt; created_at&lt;br&gt;&lt;br&gt;&lt;b&gt;user_branches&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_user_branches_branch (tenant_id, branch_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;branches&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_branches_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;warehouses&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_warehouses_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_warehouses_2 (tenant_id, id, branch_id)&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="1217" y="310" width="740" height="429" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dd-02" name="DD-02 Sản phẩm &amp; đơn vị tính"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-92" value="&lt;b&gt;02. Sản phẩm &amp;amp; đơn vị tính&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(Data Design · 7 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="categories" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="243" height="168" as="geometry"/></mxCell><mxCell id="r-2" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uuid&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontFamily=Courier New;fontSize=11;" parent="t-1" vertex="1"><mxGeometry x="0" y="28" width="243" height="20" as="geometry"/></mxCell><mxCell id="r-3" value="FK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tenant_id&amp;nbsp;&amp;nbsp;&amp;nbsp;uuid" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html