uard()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; supplier_invoice_no_delete: BEFORE DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;&lt;br&gt;&lt;b&gt;supplier_invoice_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_supplier_invoice_items_receipt_item (tenant_id, invoice_id, goods_receipt_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_supplier_invoice_items_receipt_item (tenant_id, goods_receipt_item_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_supplier_invoice_items_sku (tenant_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(quantity): quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(unit_price): unit_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(expected_quantity): expected_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(expected_unit_price): expected_unit_price &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_supplier_invoice_items_comparison: num_nonnulls(expected_quantity, expected_unit_price, quantity_diff, price_diff, amount_...&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; supplier_invoice_item_guard: BEFORE INSERT OR UPDATE OR DELETE → oisms_supplier_invoice_item_guard()&lt;br&gt;&lt;br&gt;&lt;b&gt;purchase_variances&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_purchase_variances_invoice (invoice_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_purchase_variances_receipt (tenant_id, goods_receipt_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(variance_type): variance_type IN (&#39;AtReceipt&#39;,&#39;AfterReceipt&#39;)&lt;br&gt;&amp;nbsp;&a