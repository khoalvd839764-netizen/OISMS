        <mxCell id="n-165" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;suppliers&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_suppliers_1 (tenant_id, id)&lt;br&gt;&lt;br&gt;&lt;b&gt;purchase_orders&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_purchase_orders_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_purchase_orders_2 (tenant_id, number)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_purchase_orders_3 (tenant_id, request_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_purchase_orders_status_time (tenant_id, status, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_purchase_orders_status: status IN (&#39;Draft&#39;,&#39;Approved&#39;,&#39;PartiallyReceived&#39;,&#39;Received&#39;,&#39;Closed&#39;,&#39;Cancelled&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_purchase_orders_approved: (approved_at IS NULL) = (approved_by IS NULL) AND (status NOT IN (&#39;Approved&#39;,&#39;Partially...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_purchase_orders_closed: (status = &#39;Closed&#39;) = (closed_at IS NOT NULL) AND (closed_at IS NULL) = (closed_by IS N...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_purchase_orders_cancelled: (status = &#39;Cancelled&#39;) = (cancelled_at IS NOT NULL) AND (cancelled_at IS NULL) = (cance...&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; purchase_order_guard: BEFORE UPDATE → oisms_purchase_order_guard()&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; purchase_order_no_delete: BEFORE DELETE OR TRUNCATE →