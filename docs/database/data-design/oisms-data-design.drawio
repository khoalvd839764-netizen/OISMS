        <mxCell id="n-107" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;stock_count_schedules&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_schedules_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_schedules_2 (tenant_id, warehouse_id, period_type)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_schedules_period_type: period_type IN (&#39;MidMonth&#39;, &#39;EndOfMonth&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_schedules_day: (period_type = &#39;MidMonth&#39; AND day_of_month BETWEEN 1 AND 28) OR (period_type = &#39;EndOfMo...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_schedules_due_days: due_days BETWEEN 1 AND 14&lt;br&gt;&lt;br&gt;&lt;b&gt;stock_count_periods&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIU&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_periods_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_periods_2 (tenant_id, warehouse_id, period_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_stock_count_periods_status_due (tenant_id, status, due_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_periods_period_type: period_type IN (&#39;MidMonth&#39;, &#39;EndOfMonth&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_periods_status: status IN (&#39;Planned&#39;, &#39;InProgress&#39;, &#39;Completed&#39;, &#39;Cancelled&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_periods_due: due_at &amp;gt; scheduled_at&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_periods_completed: (status = &#39;Completed&#39;) = (completed_at IS NOT NULL)&lt;br&gt;&lt;br&gt;&lt;b&gt;stock_counts&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_counts_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_counts_2 (tenant_id, number)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_counts_3 (tenant_id, request_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_counts_4 (tenant_id, generated_adjustment_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ IX uq_stock_counts_active_period (tenant_id, period_id) WHERE period_id IS NOT NULL AND status &amp;lt;&amp;gt; &#39;Cancelled&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_stock_counts_status_time (tenant_id, status, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_counts_status_values: status IN (&#39;Draft&#39;, &#39;Counting&#39;, &#39;PendingApproval&#39;, &#39;Confirmed&#39;, &#39;Cancelled&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_counts_confirmed: (status = &#39;Confirmed&#39;) = (confirmed_at IS NOT NULL) AND (confirmed_at IS NULL) = (confi...&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_counts_count_type: count_type IN (&#39;MidMonth&#39;, &#39;EndOfMonth&#39;, &#39;AdHoc&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_counts_type_period: (count_type = &#39;AdHoc&#39;) = (period_id IS NULL)&lt;br&gt;&lt;br&gt;&lt;b&gt;stock_count_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_items_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_items_2 (tenant_id, stock_count_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_items_expected_quantity_nonnegative: expected_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_items_counted_quantity_nonnegative: counted_quantity &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_items_balance_sequence_at_snapshot_nonnegative: balance_sequence_at_snapshot &amp;gt;= 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_items_adjustment_unit_cost_nonnegative: adjustment_unit_cost &amp;gt;= 0&lt;br&gt;&lt;br&gt;&lt;b&gt;stock_count_approvals&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SI&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_count_approvals_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_stock_count_approvals_count (tenant_id, stock_count_id, created_at)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_count_approvals_action: action IN (&#39;Submitted&#39;, &#39;Approved&#39;, &#39;RecountRequested&#39;, &#39;Recounted&#39;, &#39;Cancelled&#39;)&lt;br&gt;&amp;nbsp;&amp;nbsp;TRG&amp;nbsp;&amp;nbsp; stock_count_approval_append_only: BEFORE UPDATE OR DELETE OR TRUNCATE → oisms_deny_mutation()&lt;br&gt;" vertex="1">
