okeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-32" target="r-12" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-40" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-32" target="r-16" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-41" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-9" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-42" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-34" target="r-10" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-43" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-23" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-44" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-36" target="r-24" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-45" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#999999;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;" parent="1" source="r-32" target="r-13" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-47" value="&lt;b&gt;Data Design – quy ước&lt;/b&gt;&lt;br&gt;Bảng PostgreSQL 16, đủ cột và kiểu. PK gạch chân, FK khóa ngoại, UQ thuộc UNIQUE (ngoài (tenant_id, id)). Kiểu có &lt;b&gt;?&lt;/b&gt; là cột NULL được.&lt;br&gt;Nét liền: FK nghiệp vụ; nét đứt: FK người tạo/duyệt tới users. Khung viền đứt: bảng trang khác (chỉ PK).&lt;br&gt;FK đều là khóa kép (tenant_id, x_id) → (tenant_id, id); đường tới tenants chỉ vẽ ở DD-01.&lt;br&gt;Hộp bên dưới: quyền oisms_runtime, index, CHECK, trigger. Xem DD-00 cho quy ước chung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="762" y="120" width="440" height="170" as="geometry"/></mxCell><mxCell id="n-48" value="&lt;b&gt;stock_transfers&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_transfers_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_transfers_2 (tenant_id, number)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_transfers_3 (tenant_id, request_key)&lt;br&gt;&amp;nbsp;&amp;nbsp;IX&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ix_stock_transfers_status_time (tenant_id, status, created_at, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfers_status_values: status IN ('Draft', 'InTransit', 'Received', 'Cancelled')&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfers_different_warehouses: from_warehouse_id &amp;lt;&amp;gt; to_warehouse_id&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfers_dispatch_time: (status IN ('InTransit','Received')) = (dispatched_at IS NOT NULL)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfers_receive_time: (status = 'Received') = (received_at IS NOT NULL) AND (received_at IS NULL) = (received...&lt;br&gt;&lt;br&gt;&lt;b&gt;stock_transfer_items&lt;/b&gt;&amp;nbsp;&amp;nbsp; GRANT oisms_runtime: SIUD&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_transfer_items_1 (tenant_id, id)&lt;br&gt;&amp;nbsp;&amp;nbsp;UQ&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;uq_stock_transfer_items_2 (tenant_id, transfer_id, sku_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfer_items_quantity_positive: quantity &amp;gt; 0&lt;br&gt;&amp;nbsp;&amp;nbsp;CK&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ck_stock_transfer_items_unit_cost_nonnegative: unit_cost &amp;gt;= 0&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="762" y="310" width="908" height="264" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dd-07" name="DD-07 Kiểm kê"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-105" value="&lt;b&gt;07. Kiểm kê&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(Data Design · 5 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="stock_counts" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120