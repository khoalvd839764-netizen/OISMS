l><mxCell id="e-60" value="contains" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-35" target="r-29" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-61" value="receives" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-16" target="r-2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-62" value="contains" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-22" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-63" value="fulfilled by" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-35" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-64" value="received as" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-22" target="r-29" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-66" value="&lt;b&gt;ERD logic – quy ước&lt;/b&gt;&lt;br&gt;Thực thể theo entity C# (OISM.Domain). Chỉ PK (gạch chân) và thuộc tính nghiệp vụ chính; không kiểu, không cột FK, không cột kỹ thuật (tenant_id, created_at, updated_at, request_key...).&lt;br&gt;Crow's foot: | bắt buộc, o có thể không có, chân gà = nhiều. Nhãn là động từ đọc từ thực thể cha.&lt;br&gt;Chỉ vẽ quan hệ trong phân hệ; liên kết sang phân hệ khác liệt kê ở hộp bên dưới, đủ trên ERD-00.&lt;br&gt;Lược bỏ: quan hệ Tenant và quan hệ người tạo/duyệt tới User – xem Data Design.&lt;br&gt;* ReplenishmentSuggestion chưa có entity C#." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1193" y="120" width="400" height="190" as="geometry"/></mxCell><mxCell id="n-67" value="&lt;b&gt;Liên kết sang phân hệ khác&lt;/b&gt; (cha – động từ – con, 1 – nhiều)&lt;br&gt;Branch (trang 01) &lt;i&gt;places&lt;/i&gt; PurchaseOrder&lt;br&gt;Branch (trang 01) &lt;i&gt;receives&lt;/i&gt; GoodsReceipt&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;billed in&lt;/i&gt; SupplierInvoiceItem&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;ordered in&lt;/i&gt; PurchaseOrderItem&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;received in&lt;/i&gt; GoodsReceiptItem&lt;br&gt;Unit (trang 02) &lt;i&gt;unit of&lt;/i&gt; GoodsReceiptItem&lt;br&gt;Unit (trang 02) &lt;i&gt;unit of&lt;/i&gt; PurchaseOrderItem&lt;br&gt;Warehouse (trang 01) &lt;i&gt;stores&lt;/i&gt; GoodsReceipt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1193" y="330" width="400" height="166" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd-05" name="ERD-05 Tồn kho &amp; sổ cái"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-31" value="&lt;b&gt;05. Tồn kho &amp;amp; sổ cái&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(ERD logic · 5 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vert