" width="211" height="128" as="geometry"/></mxCell><mxCell id="r-9" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;id&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-8" vertex="1"><mxGeometry x="0" y="28" width="211" height="20" as="geometry"/></mxCell><mxCell id="r-10" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;forecast_date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-8" vertex="1"><mxGeometry x="0" y="48" width="211" height="20" as="geometry"/></mxCell><mxCell id="r-11" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;horizon_days" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-8" vertex="1"><mxGeometry x="0" y="68" width="211" height="20" as="geometry"/></mxCell><mxCell id="r-12" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;predicted_quantity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-8" vertex="1"><mxGeometry x="0" y="88" width="211" height="20" as="geometry"/></mxCell><mxCell id="r-13" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;suggested_quantity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-8" vertex="1"><mxGeometry x="0" y="108" width="211" height="20" as="geometry"/></mxCell><mxCell id="t-14" value="ShopIntegration" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="420" y="308" width="165" height="108" as="geometry"/></mxCell><mxCell id="r-15" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;id&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-14" vertex="1"><mxGeometry x="0" y="28" width="165" height="20" as="geometry"/></mxCell><mxCell id="r-16" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;channel" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-14" vertex="1"><mxGeometry x="0" y="48" width="165" height="20" as="geometry"/></mxCell><mxCell id="r-17" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;external_shop_id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-14" vertex="1"><mxGeometry x="0" y="68" width="165" height="20" as="geometry"/></mxCell><mxCell id="r-18" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-14" vertex="1"><mxGeometry x="0" y="88" width="165" height="20" as="geometry"/></mxCell><mxCell id="n-20" value="&lt;b&gt;ERD logic – quy ước&lt;/b&gt;&lt;br&gt;Thực thể theo entity C# (OISM.Domain). Chỉ PK (gạch chân) và thuộc tính nghiệp vụ chính; không kiểu, không cột FK, không cột kỹ thuật (tenant_id, created_at, updated_at, request_key...).&lt;br&gt;Crow's foot: | bắt buộc, o có thể không có, chân gà = nhiều. Nhãn là động từ đọc từ thực thể cha.&lt;br&gt;Chỉ vẽ quan hệ trong phân hệ; liên kết sang phân hệ khác liệt kê ở hộp bên dưới, đủ trên ERD-00.&lt;br&gt;Lược bỏ: quan hệ Tenant và quan hệ người tạo/duyệt tới User – xem Data Design.&lt;br&gt;* ReplenishmentSuggestion chưa có entity C#." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="831" y="120" width="400" height="190" as="geometry"/></mxCell><mxCell id="n-21" value="&lt;b&gt;Liên kết sang phân hệ khác&lt;/b&gt; (cha – động từ – con, 1 – nhiều)&lt;br&gt;Branch (trang 01) &lt;i&gt;linked to&lt;/i&gt; ShopIntegration&lt;br&gt;Branch (trang 01) &lt;i&gt;suggested for&lt;/i&gt; ReplenishmentSuggestion*&lt;br&gt;Branch (trang 01) &lt;i&gt;summarized in&lt;/i&gt; DailySalesSummary&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;suggested for&lt;/i&gt; ReplenishmentSuggestion*&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;summarized in&lt;/i&gt; DailySalesSummary" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="831" y="330" width="400" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
