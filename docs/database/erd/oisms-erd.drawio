lor=#FFFFFF;" parent="1" source="r-2" target="r-19" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-47" value="used as" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-36" target="r-19" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-48" value="logs factor" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-19" target="r-10" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-50" value="&lt;b&gt;ERD logic – quy ước&lt;/b&gt;&lt;br&gt;Thực thể theo entity C# (OISM.Domain). Chỉ PK (gạch chân) và thuộc tính nghiệp vụ chính; không kiểu, không cột FK, không cột kỹ thuật (tenant_id, created_at, updated_at, request_key...).&lt;br&gt;Crow's foot: | bắt buộc, o có thể không có, chân gà = nhiều. Nhãn là động từ đọc từ thực thể cha.&lt;br&gt;Chỉ vẽ quan hệ trong phân hệ; liên kết sang phân hệ khác liệt kê ở hộp bên dưới, đủ trên ERD-00.&lt;br&gt;Lược bỏ: quan hệ Tenant và quan hệ người tạo/duyệt tới User – xem Data Design.&lt;br&gt;* ReplenishmentSuggestion chưa có entity C#." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1140" y="120" width="400" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd-03" name="ERD-03 Bảng giá"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-25" value="&lt;b&gt;03. Bảng giá&lt;/b&gt;  &lt;font sty