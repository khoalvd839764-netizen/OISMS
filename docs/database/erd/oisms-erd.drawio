w=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-14" target="r-26" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-34" value="generates" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-2" target="r-14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-35" value="logs approval" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" parent="1" source="r-26" target="r-21" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-37" value="&lt;b&gt;ERD logic – quy ước&lt;/b&gt;&lt;br&gt;Thực thể theo entity C# (OISM.Domain). Chỉ PK (gạch chân) và thuộc tính nghiệp vụ chính; không kiểu, không cột FK, không cột kỹ thuật (tenant_id, created_at, updated_at, request_key...).&lt;br&gt;Crow's foot: | bắt buộc, o có thể không có, chân gà = nhiều. Nhãn là động từ đọc từ thực thể cha.&lt;br&gt;Chỉ vẽ quan hệ trong phân hệ; liên kết sang phân hệ khác liệt kê ở hộp bên dưới, đủ trên ERD-00.&lt;br&gt;Lược bỏ: quan hệ Tenant và quan hệ người tạo/duyệt tới User – xem Data Design.&lt;br&gt;* ReplenishmentSuggestion chưa có entity C#." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1137" y="120" width="400" height="190" as="geometry"/></mxCell><mxCell id="n-38" value="&lt;b&gt;Liên kết sang phân hệ khác&lt;/b&gt; (cha – động từ – con, 1 – nhiều)&lt;br&gt;Branch (trang 01) &lt;i&gt;counts&lt;/i&gt; StockCount&lt;br&gt;InventoryAdjustment (trang 05) &lt;i&gt;generated by&lt;/i&gt; StockCount&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;counted in&lt;/i&gt; StockCountItem&lt;br&gt;Warehouse (trang 01) &lt;i&gt;counted by&lt;/i&gt; StockCount&lt;br&gt;Warehouse (trang 01) &lt;i&gt;scheduled for&lt;/i&gt; StockCountPeriod&lt;br&gt;Warehouse (trang 01) &lt;i&gt;scheduled for&lt;/i&gt; StockCountSchedule" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1137" y="330" width="400" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd-08" name="ERD-08 Đơn hàng – POS – thanh toán"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-48" value="&lt;b&gt;08. Đơn hàng – POS – thanh toán&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(ERD logic · 6 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="Order" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="160" height="168" as="geometry"/></mxCell><mxCell id="r-2" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;id&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;" parent="t-1" vertex="1"><mxGeometry x="0" y="28" width="160" height="20" as="geometry"/></mxCell><mxCell id="r-3" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;number" 