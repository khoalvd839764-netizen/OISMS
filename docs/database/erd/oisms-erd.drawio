t="1" vertex="1"><mxGeometry x="400" y="120" width="400" height="190" as="geometry"/></mxCell><mxCell id="n-15" value="&lt;b&gt;Liên kết sang phân hệ khác&lt;/b&gt; (cha – động từ – con, 1 – nhiều)&lt;br&gt;Branch (trang 01) &lt;i&gt;ships from&lt;/i&gt; StockTransfer&lt;br&gt;Branch (trang 01) &lt;i&gt;ships to&lt;/i&gt; StockTransfer&lt;br&gt;ProductVariant (trang 02) &lt;i&gt;transferred in&lt;/i&gt; StockTransferItem&lt;br&gt;Warehouse (trang 01) &lt;i&gt;ships from&lt;/i&gt; StockTransfer&lt;br&gt;Warehouse (trang 01) &lt;i&gt;ships to&lt;/i&gt; StockTransfer" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="400" y="330" width="400" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd-07" name="ERD-07 Kiểm kê"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h-36" value="&lt;b&gt;07. Kiểm kê&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;(ERD logic · 5 bảng)&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t-1" value="StockCountSchedule" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=0;fillColor=#F5F5F5;strokeColor=#333333;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="164" height="148" as="geometry"/></mxCell><mxCell id="r-2" value="&lt;u&gt;PK&amp;nbsp;&amp;nbsp;id&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0