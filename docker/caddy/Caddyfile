# API, SignalR và health/live đi vào backend; /health/ready chỉ dùng nội bộ (BF-026)
(backend_routes) {
	handle /health/ready {
		respond 403
	}
	@backend path /api/* /hubs/* /health/live
	handle @backend {
		reverse_proxy backend:8080
	}
}

{$ADMIN_DOMAIN} {
	tls {
		protocols tls1.3
	}
	encode gzip
	import backend_routes
	handle {
		reverse_proxy admin-dashboard:80
	}
}

{$POS_DOMAIN} {
	tls {
		protocols tls1.3
	}
	encode gzip
	import backend_routes
	handle {
		reverse_proxy pos-app:80
	}
}

# Giả lập đơn sàn: chỉ mở đường webhook, không mở các API khác hoặc /health/ready
{$SIM_DOMAIN} {
	tls {
		protocols tls1.3
	}
	encode gzip
	handle /health/ready {
		respond 403
	}
	handle /health/live {
		reverse_proxy backend:8080
	}
	handle /api/webhooks/* {
		reverse_proxy backend:8080
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy marketplace-simulator:80
	}
}
