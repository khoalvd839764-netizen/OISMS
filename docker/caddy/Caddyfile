# API, SignalR và health đi vào backend; còn lại là file tĩnh của frontend
(backend_routes) {
	@backend path /api/* /hubs/* /health /health/*
	handle @backend {
		reverse_proxy backend:8080
	}
}

{$ADMIN_DOMAIN} {
	encode gzip
	import backend_routes
	handle {
		reverse_proxy admin-dashboard:80
	}
}

{$POS_DOMAIN} {
	encode gzip
	import backend_routes
	handle {
		reverse_proxy pos-app:80
	}
}

# Giả lập đơn sàn: chỉ mở đường webhook, không mở các API khác trên domain này
{$SIM_DOMAIN} {
	encode gzip
	handle /api/webhooks/* {
		reverse_proxy backend:8080
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy marketplace-simulator:80
	}
}
