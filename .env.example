# Environment Variables Example

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oism_db
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Backend API (.NET 8)
BACKEND_PORT=5000
BACKEND_HTTPS_PORT=5001
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=SuperSecretKeyForOISMOmnichannelRetailSystem2026!#
JWT_ISSUER=OISM_WebAPI
JWT_AUDIENCE=OISM_Client
JWT_EXPIRY_MINUTES=60

# Frontend Ports
ADMIN_PORT=5173
POS_PORT=5174
VITE_API_BASE_URL=http://localhost:5000/api
