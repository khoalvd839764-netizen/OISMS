# Mẫu biến môi trường khi deploy. Trên máy chủ: chép thành .env.production rồi đổi toàn bộ giá trị CHANGE_ME.
# Tạo giá trị ngẫu nhiên: openssl rand -hex 32
# Không commit .env.production.

# Domain của 3 frontend; Compose nhúng VITE_POS_URL/VITE_ADMIN_URL tương ứng lúc build
ADMIN_DOMAIN=admin.203.0.113.10.sslip.io
POS_DOMAIN=pos.203.0.113.10.sslip.io
SIM_DOMAIN=sim.203.0.113.10.sslip.io

# Tài khoản quản trị PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=oisms

# Tài khoản runtime của backend
OISMS_APP_USER=oisms_app
OISMS_APP_PASSWORD=CHANGE_ME

# Khóa ký JWT, tối thiểu 32 ký tự
JWT_SECRET=CHANGE_ME

# Hangfire: bật job hết hạn giữ chỗ và sinh kỳ kiểm kê.
# Trước khi bật: backup DB rồi chạy docker/postgres/migrations/20261108_hangfire_schema.sql bằng tài khoản postgres.
# Lần chạy đầu sẽ hủy mọi đơn đang giữ chỗ đã quá hạn.
HANGFIRE_ENABLED=false
HANGFIRE_WORKER_COUNT=2

# docker-compose.yml bắt buộc có biến này dù pgAdmin không chạy trên máy chủ
PGADMIN_PASSWORD=CHANGE_ME
