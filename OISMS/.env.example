# ==============================================================================
# OISMS - Environment Variables Configuration Template
# Copy this file to .env and configure secret credentials before running.
# Never commit real passwords or production secrets to Git.
# ==============================================================================

# Database: PostgreSQL 16+ (Admin / Migration Account)
# Used for DDL, schema initialization, and administrative tasks.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=oisms
POSTGRES_PORT=5432

# Database: Application Runtime Account (Least-Privilege Role: oisms_runtime)
# Used by Backend API for daily CRUD operations. Cannot alter schema or drop tables.
# NOTE: OISMS_APP_USER must NOT be identical to POSTGRES_USER ('postgres') or group role ('oisms_runtime').
OISMS_APP_USER=oisms_app
# Mật khẩu hỗ trợ dấu nháy và ký tự đặc biệt (ví dụ: !@#%^&*).
# LƯU Ý DOCKER COMPOSE: Nếu mật khẩu chứa ký tự '$', hãy viết thành '$$' trong file .env để tránh Docker Compose hiểu nhầm là biến môi trường.
OISMS_APP_PASSWORD=admin123

# LƯU Ý VỀ VOLUME ĐÃ TỒN TẠI:
# Việc thay đổi POSTGRES_PASSWORD hoặc OISMS_APP_PASSWORD trong file .env sẽ KHÔNG tự động cập nhật mật khẩu của role
# trên database volume đã tồn tại (postgres_data). Đối với volume cũ, hãy dùng lệnh ALTER ROLE qua psql quản trị.

# Redis Cache & Background Tasks
REDIS_PORT=6379

# PgAdmin Management UI (Optional)
PGADMIN_EMAIL=admin@oisms.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Backend Web API (.NET 8)
BACKEND_PORT=5000
BACKEND_HTTPS_PORT=5001
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=SuperSecretKeyForOISMOmnichannelRetailSystem2026!#
JWT_ISSUER=OISM_WebAPI
JWT_AUDIENCE=OISM_Client
JWT_EXPIRY_MINUTES=60

# Frontend Applications
ADMIN_PORT=5173
POS_PORT=5174
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Database Connection Reference:
# 1. Discrete Keys (Khuyên dùng - được Docker Compose sử dụng mặc định, an toàn với ký tự đặc biệt/chấm phẩy):
#    Database__Host=postgres
#    Database__Port=5432
#    Database__Database=oisms
#    Database__Username=oisms_app
#    Database__Password=your_oisms_runtime_password_here
#
# 2. ConnectionStrings Fallback:
#    - Inside Docker: ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=oisms;Username=oisms_app;Password=your_oisms_runtime_password_here
#    - Host Local:   ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=oisms;Username=oisms_app;Password=your_oisms_runtime_password_here
